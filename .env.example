# Environment Configuration Template
# Copy this file to .env.development and .env.production and fill in your values

# App Environment (development, staging, production)
APP_ENV=development

# AdMob Configuration
# Get your AdMob App IDs from https://admob.google.com
# iOS App ID format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# Android App ID format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713

# AdMob Ad Unit IDs
# Get your Ad Unit IDs from https://admob.google.com
# Format: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_IOS_BANNER_ID=ca-app-pub-3940256099942544/2435281174
ADMOB_ANDROID_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-3940256099942544/4411468910
ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_IOS_REWARDED_ID=ca-app-pub-3940256099942544/1712485313
ADMOB_ANDROID_REWARDED_ID=ca-app-pub-3940256099942544/5224910975

# Sentry Configuration (for error tracking)
# Get your DSN from https://sentry.io
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_PROJECT=
SENTRY_ORG=

# Analytics Configuration
# Firebase Project ID
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# App Configuration
APP_NAME=Meme Generator
APP_VERSION=1.0.0
APP_BUNDLE_ID_IOS=com.memegen.app
APP_BUNDLE_ID_ANDROID=com.memegen.app

# API Configuration (if needed in future)
API_BASE_URL=https://api.example.com
API_TIMEOUT=30000

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_ADS=true

# Premium Features Configuration
FREEMIUM_MEME_LIMIT=5
PREMIUM_PRICE_USD=4.99
