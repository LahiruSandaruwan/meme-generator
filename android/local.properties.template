# This file should be created locally and not committed to version control
# Copy this file to local.properties and update with your actual Android SDK path

# Android SDK location
# On macOS: /Users/YOUR_USERNAME/Library/Android/sdk
# On Linux: /home/YOUR_USERNAME/Android/sdk
# On Windows: C:\Users\YOUR_USERNAME\AppData\Local\Android\sdk
sdk.dir=YOUR_ANDROID_SDK_PATH_HERE

# Example for macOS:
# sdk.dir=/Users/john/Library/Android/sdk

# Example for Linux:
# sdk.dir=/home/john/Android/sdk

# Example for Windows:
# sdk.dir=C:\\Users\\john\\AppData\\Local\\Android\\sdk
